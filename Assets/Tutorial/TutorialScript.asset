%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8dad39bead1085f4abe2454a2105430b, type: 3}
  m_Name: TutorialScript
  m_EditorClassIdentifier: Assembly-CSharp::Promotion.Tutorial.TutorialScript
  speakerName: "\uC548\uB0B4\uC778"
  portrait: {fileID: 21300000, guid: f3ac0ab8b2e6fac4da9e5d63d6d8eda5, type: 3}
  storyBackground: {fileID: 21300000, guid: 16c51a37d6df0b2419b13f26eaa7d12d, type: 3}
  storyBackgroundShade: 0.8
  stage: {fileID: 11400000, guid: 7c8277538303a3a4ca24dc23742a5060, type: 2}
  charactersPerSecond: 40
  steps:
  - text: "\uC548\uB155\uD558\uC138\uC694! \uC800\uB294 \uC774\uACF3\uC758 \uC548\uB0B4\uB97C
      \uB9E1\uC740 \uC548\uB0B4\uC778\uC774\uC5D0\uC694.\n\uCC98\uC74C \uC624\uC168\uAD70\uC694?
      \uC81C\uAC00 \uCC28\uADFC\uCC28\uADFC \uC54C\uB824 \uB4DC\uB9B4\uAC8C\uC694."
    wait: 0
    action: 0
    portrait: {fileID: -367406339, guid: b5bc08d628e02d44e8bc2fd1fa99b589, type: 3}
    storyFrame: {fileID: 0}
    coverBoard: 1
    focus: 0
  - text: "(\uC138\uACC4\uAD00 \uC124\uBA85 1 \u2014 \uCCAB \uBC88\uC9F8 \uCEF7\uC5D0
      \uB9DE\uB294 \uB300\uC0AC\uB97C \uC9C1\uC811 \uC785\uB825\uD558\uC138\uC694)"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 21300000, guid: 17eb8149017e17d4a8dddd8bd91af73f, type: 3}
    coverBoard: 1
    focus: 0
  - text: "(\uC138\uACC4\uAD00 \uC124\uBA85 2 \u2014 \uB450 \uBC88\uC9F8 \uCEF7\uC5D0
      \uB9DE\uB294 \uB300\uC0AC\uB97C \uC9C1\uC811 \uC785\uB825\uD558\uC138\uC694)"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 21300000, guid: c2b393d693b5a8649bd248b06ddfbd13, type: 3}
    coverBoard: 1
    focus: 0
  - text: "(\uC138\uACC4\uAD00 \uC124\uBA85 3 \u2014 \uC138 \uBC88\uC9F8 \uCEF7\uC5D0
      \uB9DE\uB294 \uB300\uC0AC\uB97C \uC9C1\uC811 \uC785\uB825\uD558\uC138\uC694)"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 21300000, guid: 42a703151f6bbae4aa21644578ae24c8, type: 3}
    coverBoard: 1
    focus: 0
  - text: "(\uC138\uACC4\uAD00 \uC124\uBA85 4 \u2014 \uB124 \uBC88\uC9F8 \uCEF7\uC5D0
      \uB9DE\uB294 \uB300\uC0AC\uB97C \uC9C1\uC811 \uC785\uB825\uD558\uC138\uC694)"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 21300000, guid: 103ee5f1caa62804caa5ebd553d1650d, type: 3}
    coverBoard: 1
    focus: 0
  - text: "\uC557, \uC800\uAE30 \uBCF4\uC138\uC694! \uC801\uC774 \uBAB0\uB824\uC624\uACE0
      \uC788\uC5B4\uC694!"
    wait: 0
    action: 1
    portrait: {fileID: 1547360486, guid: 3541545db66a39a42b28ccc8f7f73dfb, type: 3}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC801\uC740 \uB9E4 \uD134 \uD0B9\uC744 \uD5A5\uD574 \uD55C \uCE78\uC529
      \uB2E4\uAC00\uC640\uC694.\n\uC801\uC774 \uD0B9\uC774 \uC788\uB294 \uCE78\uC5D0
      \uB4E4\uC5B4\uC624\uBA74 \uC6B0\uB9AC\uAC00 \uC9C0\uB294 \uAC70\uC608\uC694."
    wait: 0
    action: 0
    portrait: {fileID: -640357852, guid: 1d348172d9be4b44689ee7eb4831ee7c, type: 3}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uBA3C\uC800 \uC6B0\uB9AC\uC758 \uD0B9\uC744 \uB193\uC544\uC57C \uD574\uC694.
      \uC624\uB978\uCABD \uC778\uBCA4\uD1A0\uB9AC \uAE30\uBB3C \uCE78\uC5D0\uC11C
      \uD0B9\uC744 \uACE0\uB978 \uB4A4, \uC544\uB798\uCABD \uBE5B\uB098\uB294 \uCE78\uC5D0
      \uB193\uC544 \uC8FC\uC138\uC694."
    wait: 1
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC88B\uC544\uC694! \uC774\uC81C \uC624\uB978\uCABD \uC544\uB798 '\uC2A4\uD14C\uC774\uC9C0
      \uC2DC\uC791' \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC8FC\uC138\uC694."
    wait: 2
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC804\uD22C\uAC00 \uC2DC\uC791\uB418\uBA74 \uB9E4 \uD134 AP\uB97C \uBC1B\uC544\uC694.\n\uAE30\uBB3C\uC744
      \uC18C\uD658\uD558\uAC70\uB098 \uC6C0\uC9C1\uC77C \uB54C\uB9C8\uB2E4 AP\uB97C
      \uC368\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C \uD3F0\uC744 \uACE0\uB974\uACE0,
      \uD0B9 \uADFC\uCC98 \uBE5B\uB098\uB294 \uCE78\uC5D0 \uC18C\uD658\uD574 \uBCF4\uC138\uC694.
      (AP 1)"
    wait: 3
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC798\uD588\uC5B4\uC694! \uD3F0\uC740 \uC55E\uC73C\uB85C \uD55C \uCE78\uC529
      \uC6C0\uC9C1\uC774\uACE0,\n\uB300\uAC01\uC120 \uC55E\uC5D0 \uC788\uB294 \uC801\uC744
      \uC7A1\uC744 \uC218 \uC788\uC5B4\uC694."
    wait: 0
    action: 0
    portrait: {fileID: -367406339, guid: b5bc08d628e02d44e8bc2fd1fa99b589, type: 3}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uD3F0\uC744 \uB354 \uC18C\uD658\uD558\uAC70\uB098 \uC6C0\uC9C1\uC778
      \uB4A4 '\uD134 \uC885\uB8CC'\uB97C \uB204\uB974\uBA74 \uC801\uC774 \uC6C0\uC9C1\uC5EC\uC694.\n\uC801\uC744
      \uBAA8\uB450 \uB9C9\uC544 \uB0B4 \uBCF4\uC138\uC694!"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC801\uC744 \uBAA8\uB450 \uC7A1\uACE0 \uD134\uC744 \uC885\uB8CC\uD558\uBA74
      \uC2B9\uB9AC! (\uD3F0\uC740 \uB300\uAC01\uC120 \uC55E\uC758 \uC801\uC744 \uC7A1\uC544\uC694)"
    wait: 4
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uD6CC\uB96D\uD574\uC694! \uCCAB \uC804\uD22C\uB97C \uBB34\uC0AC\uD788
      \uB9C9\uC544 \uB0C8\uC5B4\uC694.\n\uC2B9\uB9AC\uD558\uBA74 \uBCF4\uC0C1\uC73C\uB85C
      \uACE8\uB4DC\uB97C \uBC1B\uC544\uC694."
    wait: 0
    action: 0
    portrait: {fileID: -367406339, guid: b5bc08d628e02d44e8bc2fd1fa99b589, type: 3}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  shopPool: {fileID: 11400000, guid: 64e09915017c2ad44a26a4a07c6d3a38, type: 2}
  shopReward: 6
  shopSteps:
  - text: "\uACE8\uB4DC\uB294 \uC774\uACF3 \uC0C1\uC810\uC5D0\uC11C \uC4F8 \uC218
      \uC788\uC5B4\uC694.\n\uC804\uD22C\uC5D0\uC11C \uC774\uAE38 \uB54C\uB9C8\uB2E4
      \uC0C1\uC810\uC774 \uC5F4\uB9B0\uB2F5\uB2C8\uB2E4."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC624\uB978\uCABD \uC704\uC5D0\uB294 \uC9C0\uAE08 \uAC00\uC9C4 \uACE8\uB4DC\uAC00
      \uD45C\uC2DC\uB3FC\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 1
  - text: "\uC704\uCABD \uC904\uC5D0\uB294 \uC720\uBB3C\uC774 \uC9C4\uC5F4\uB3FC\uC694.\n\uAC00\uC9C0\uACE0\uB9CC
      \uC788\uC5B4\uB3C4 \uC5EC\uC815 \uB0B4\uB0B4 \uD798\uC774 \uB418\uB294 \uD2B9\uBCC4\uD55C
      \uBB3C\uAC74\uC774\uC5D0\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 2
  - text: "\uC544\uB798\uCABD \uC904\uC740 \uAE30\uBB3C\uC774\uC5D0\uC694.\n\uC0B0
      \uAE30\uBB3C\uC740 \uC804\uD22C \uC911\uC5D0 AP\uB97C \uC368\uC11C \uC18C\uD658\uD560
      \uC218 \uC788\uC5B4\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 3
  - text: "\uCE74\uB4DC\uC5D0\uB294 \uAE30\uBB3C\uC774 \uC6C0\uC9C1\uC774\uB294 \uBC29\uBC95\uC774
      \uC801\uD600 \uC788\uACE0,\n\uC544\uB798\uCABD \uAE08\uC0C9 \uD45C\uC2DC\uAC00
      \uAC00\uACA9\uC774\uC5D0\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 3
  - text: "\uCC38, \uB8E9\uC744 \uB370\uB824\uAC00\uBA74 \uD0B9\uACFC \uC790\uB9AC\uB97C
      \uBC14\uAFB8\uB294 '\uCE90\uC2AC\uB9C1'\uB3C4 \uC4F8 \uC218 \uC788\uC5B4\uC694.\n\uC2A4\uD14C\uC774\uC9C0\uB9C8\uB2E4
      \uD55C \uBC88\uBFD0\uC774\uB2C8, \uC704\uAE09\uD560 \uB54C \uB5A0\uC62C\uB824
      \uBCF4\uC138\uC694!"
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 3
  - text: "\uB9C8\uC74C\uC5D0 \uB4DC\uB294 \uAE30\uBB3C\uC744 \uD558\uB098 \uB20C\uB7EC\uC11C
      \uC0AC \uBCF4\uC138\uC694."
    wait: 5
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 3
  - text: "\uC798\uD588\uC5B4\uC694! \uC0B0 \uB9CC\uD07C \uACE8\uB4DC\uAC00 \uC904\uC5C8\uC8E0?\n\uACE8\uB4DC\uAC00
      \uBAA8\uC790\uB780 \uCE74\uB4DC\uB294 \uB20C\uB7EC\uB3C4 \uC0B4 \uC218 \uC5C6\uC5B4\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 1
  - text: "\uC774\uBC88 \uC0C1\uC810\uC740 \uC5F0\uC2B5\uC774\uB77C, \uC5EC\uAE30\uC11C
      \uC0B0 \uAE30\uBB3C\uC740\n\uC2E4\uC81C \uC5EC\uC815\uC5D0\uB294 \uB0A8\uC9C0
      \uC54A\uC544\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC900\uBE44\uAC00 \uB05D\uB0AC\uB2E4\uBA74 \uC624\uB978\uCABD \uC544\uB798
      '\uB2E4\uC74C' \uBC84\uD2BC\uC744 \uB20C\uB7EC \uC8FC\uC138\uC694."
    wait: 6
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 4
  mapSteps:
  - text: "\uC5EC\uAE30\uB294 \uC5EC\uC815\uC758 \uC9C0\uB3C4\uC608\uC694.\n\uC544\uB798\uC5D0\uC11C
      \uCD9C\uBC1C\uD574 \uD55C \uCE35\uC529 \uC704\uB85C \uC62C\uB77C\uAC00\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 0
  - text: "\uC704\uCABD\uC5D0\uB294 \uC9C0\uAE08 \uBA87 \uCE35\uC5D0 \uC788\uB294\uC9C0\uC640\n\uAC00\uC9C4
      \uACE8\uB4DC\uAC00 \uD45C\uC2DC\uB3FC\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 5
  - text: "\uBE5B\uB098\uB294 \uCE78\uC774 \uC9C0\uAE08 \uAC08 \uC218 \uC788\uB294
      \uACF3\uC774\uC5D0\uC694.\n\uC120\uC73C\uB85C \uC774\uC5B4\uC9C4 \uAE38\uC744
      \uB530\uB77C\uC11C\uB9CC \uAC08 \uC218 \uC788\uC5B4\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 6
  - text: "\uCE7C \uBAA8\uC591 \uCE78\uC5D0\uC11C\uB294 \uC804\uD22C\uAC00 \uBC8C\uC5B4\uC838\uC694.\n\uC774\uAE30\uBA74
      \uB2E4\uC2DC \uC0C1\uC810\uC5D0\uC11C \uACE8\uB4DC\uB97C \uC4F8 \uC218 \uC788\uC5B4\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 6
  - text: "\uB9E8 \uAF2D\uB300\uAE30\uC758 \uC655\uAD00\uC774 \uBCF4\uC2A4\uC608\uC694.\n\uADF8\uACF3\uC5D0\uC11C
      \uC801\uC758 \uD0B9\uACFC \uC9C4\uC9DC \uCCB4\uC2A4 \uB300\uACB0\uC744 \uD3BC\uCE58\uAC8C
      \uB3FC\uC694."
    wait: 0
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 7
  - text: "\uC774\uC81C \uCCAB \uBC88\uC9F8\uB85C \uAC08 \uACF3\uC744 \uACE8\uB77C
      \uBCF4\uC138\uC694!"
    wait: 7
    action: 0
    portrait: {fileID: 0}
    storyFrame: {fileID: 0}
    coverBoard: 0
    focus: 6
