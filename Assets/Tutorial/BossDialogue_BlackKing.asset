%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 653176373157f2d418dc2a05bf0ee3ca, type: 3}
  m_Name: BossDialogue_BlackKing
  m_EditorClassIdentifier: Assembly-CSharp::Promotion.Tutorial.BossDialogue
  speakerName: "\uBE14\uB799 \uD0B9"
  portrait: {fileID: 21300000, guid: f87f53987512a63459b83f5bb7fa56b4, type: 3}
  storyBackground: {fileID: 0}
  charactersPerSecond: 32
  intro:
  - text: "...\uC5EC\uAE30\uAE4C\uC9C0 \uC62C\uB77C\uC654\uB098. \uD3F0 \uD558\uB098\uB85C
      \uC2DC\uC791\uD55C \uC790\uAC00."
    portrait: {fileID: 0}
    coverBoard: 1
  - text: "\uB124\uAC00 \uC9C0\uB098\uC628 \uD310 \uC704\uC758 \uAE30\uBB3C\uB4E4,
      \uADF8 \uC6C0\uC9C1\uC784\uC744 \uBAA8\uB450 \uC9C0\uCF1C\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    coverBoard: 1
  - text: "\uB098\uC774\uD2B8\uC758 \uB3C4\uC57D, \uBE44\uC20D\uC758 \uC0AC\uC120,
      \uB8E9\uC758 \uC9C1\uC9C4... \uC81C\uBC95 \uC775\uD614\uB354\uAD70."
    portrait: {fileID: 0}
    coverBoard: 1
  - text: "\uD5C8\uB098 \uC774\uACF3\uC740 \uB2E4\uB974\uB2E4. \uC774 \uD310\uC5D0\uC11C\uB294
      \uB098 \uC5ED\uC2DC \uADDC\uCE59\uC744 \uB530\uB978\uB2E4."
    portrait: {fileID: 0}
    coverBoard: 1
  - text: "\uC9C4\uC9DC \uCCB4\uC2A4\uB2E4. \uCCB4\uD06C\uBA54\uC774\uD2B8\uB9CC\uC774
      \uB098\uB97C \uBB34\uB108\uB728\uB9B4 \uC218 \uC788\uB2E4. \uC640\uB77C."
    portrait: {fileID: 0}
    coverBoard: 0
  victory:
  - text: "...\uCCB4\uD06C\uBA54\uC774\uD2B8\uC778\uAC00."
    portrait: {fileID: 0}
    coverBoard: 0
  - text: "\uD3F0\uC774 \uB05D\uAE4C\uC9C0 \uAC78\uC5B4\uAC00 \uC655\uAD00\uC744
      \uC4F0\uB294 \uAC83. \uADF8\uAC83\uC744 \uC2B9\uACA9\uC774\uB77C \uD558\uC9C0."
    portrait: {fileID: 0}
    coverBoard: 1
  - text: "\uC774 \uD310\uC740 \uC774\uC81C \uB124 \uAC83\uC774\uB2E4."
    portrait: {fileID: 0}
    coverBoard: 1
  defeat:
  - text: "\uCCB4\uD06C\uBA54\uC774\uD2B8. \uC544\uC9C1 \uD310\uC744 \uC77D\uB294
      \uB208\uC774 \uBD80\uC871\uD558\uAD70."
    portrait: {fileID: 0}
    coverBoard: 0
  - text: "\uB2E4\uC2DC \uC62C\uB77C\uC640\uB77C. \uC774 \uC790\uB9AC\uC5D0\uC11C
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uACA0\uB2E4."
    portrait: {fileID: 0}
    coverBoard: 1
  onPlayerCapture:
  - "\uD765, \uADF8 \uC815\uB3C4 \uD76C\uC0DD\uC740 \uACC4\uC0B0 \uC548\uC774\uB2E4."
  - "\uC81C\uBC95\uC774\uAD70."
  - "\uAE30\uBB3C \uD558\uB098\uC5D0 \uB4E4\uB728\uC9C0 \uB9C8\uB77C."
  - "\uADF8 \uC218, \uAE30\uC5B5\uD574 \uB450\uC9C0."
  - "\uC88B\uB2E4. \uC870\uAE08\uC740 \uC7AC\uBBF8\uC788\uC5B4\uC84C\uAD70."
  onPlayerCheck:
  - "...\uCCB4\uD06C\uB77C. \uAC10\uD788."
  - "\uB0B4 \uD0B9\uC744 \uB178\uB9AC\uB294\uAC00."
  - "\uC774 \uC815\uB3C4\uB85C \uBAB0\uB838\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB098?"
  - "\uB0A0\uCE74\uB86D\uAD70. \uD558\uC9C0\uB9CC \uC544\uC9C1\uC774\uB2E4."
  bubbleSeconds: 2.6
